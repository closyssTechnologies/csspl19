<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Category -->
    <record id="module_category_payment_date_approval" model="ir.module.category">
        <field name="name">Payment Month Date Approval</field>
        <field name="description">Access management for payment month date locking and approval workflow.</field>
        <field name="sequence">35</field>
    </record>

    <!-- Security Privilege -->
    <record id="res_groups_privilege_payment_date_approval" model="res.groups.privilege">
        <field name="name">Payment Month Date Approval</field>
        <field name="category_id" ref="module_category_payment_date_approval"/>
    </record>

    <!-- Security Groups -->
    <record id="group_payment_date_change_user" model="res.groups">
        <field name="name">Payment Date Change User</field>
        <field name="privilege_id" ref="res_groups_privilege_payment_date_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Users who can submit date change requests for payments and view their own requests.</field>
    </record>

    <record id="group_payment_date_change_approver" model="res.groups">
        <field name="name">Payment Date Change Approver</field>
        <field name="privilege_id" ref="res_groups_privilege_payment_date_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_date_change_user'))]"/>
        <field name="comment">Approvers who can view, approve, and reject assigned payment date change requests.</field>
    </record>

    <record id="group_payment_date_change_admin" model="res.groups">
        <field name="name">Payment Date Change Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_payment_date_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_date_change_approver'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Administrators who can configure the approver and manage all approval records.</field>
    </record>

    <!-- Record Rules -->
    <record id="rule_payment_date_change_approval_user" model="ir.rule">
        <field name="name">Payment Date Change Approval: User (Own Requests)</field>
        <field name="model_id" ref="model_payment_month_date_change_approval"/>
        <field name="groups" eval="[(4, ref('group_payment_date_change_user'))]"/>
        <field name="domain_force">['|', ('requested_by', '=', user.id), ('payment_id.create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_payment_date_change_approval_approver" model="ir.rule">
        <field name="name">Payment Date Change Approval: Approver (Assigned Requests)</field>
        <field name="model_id" ref="model_payment_month_date_change_approval"/>
        <field name="groups" eval="[(4, ref('group_payment_date_change_approver'))]"/>
        <field name="domain_force">['|', ('requested_by', '=', user.id), ('approver_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_payment_date_change_approval_admin" model="ir.rule">
        <field name="name">Payment Date Change Approval: Admin (All Requests)</field>
        <field name="model_id" ref="model_payment_month_date_change_approval"/>
        <field name="groups" eval="[(4, ref('group_payment_date_change_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>

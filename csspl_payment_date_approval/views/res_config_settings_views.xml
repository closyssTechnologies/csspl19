<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_payment_date" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.payment.date</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Payment Month Date Approval" id="payment_month_date_approval_setting">
                    <setting id="payment_month_date_approver_setting"
                             string="Payment Month Date Approver"
                             help="Select the authorized user who reviews and approves Payment Month Date change requests."
                             groups="csspl_payment_date_approval.group_payment_date_change_admin">
                        <field name="payment_month_date_approver_id" options="{'no_create': True, 'no_open': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
